generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Category {
  id       Int       @id @default(autoincrement())
  name     String    @unique
  products Product[]
}

model Product {
  id         Int        @id @default(autoincrement())
  name       String     @unique
  price      Float
  quantity   Int
  soldCount Int @default(0)
  costPrice  Float @default(0)
  categoryId Int?
  packaging  String?
  category   Category?  @relation(fields: [categoryId], references: [id])
  createdAt  DateTime   @default(now())
  billItems  BillItem[]
}

model Bill {
  id           Int        @id @default(autoincrement())
  totalAmount  Float
  paymentType  String
  discount     Float      @default(0)
  customerName String?
  isPaid       Boolean    @default(true)
  createdAt    DateTime   @default(now())
  items        BillItem[]
}

model BillItem {
  id        Int     @id @default(autoincrement())
  quantity  Int
  price     Float
  billId    Int
  productId Int
  bill      Bill    @relation(fields: [billId], references: [id])
  product   Product @relation(fields: [productId], references: [id])
}

model Expense {
  id        Int      @id @default(autoincrement())
  title     String
  amount    Float
  createdAt DateTime @default(now())
}
